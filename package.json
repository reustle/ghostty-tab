{
  "name": "ghostty-tab",
  "version": "0.1.0",
  "description": "A bookmarkable local or SSH Ghostty terminal in a browser tab",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "bin": {
    "ghostty-tab": "./dist/server/bin/ghostty-tab.js"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/bin/ghostty-tab.ts --dev",
    "start": "node dist/server/bin/ghostty-tab.js",
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.server.json && vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --check .",
    "fmt:fix": "prettier --write --cache .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "bun run fmt && bun run lint && bun run typecheck && bun test && bun run build",
    "prepack": "bun run check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ghostty",
    "terminal",
    "tmux",
    "ssh",
    "web",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/reustle/ghostty-tab.git"
  },
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "^1.0.1",
    "ghostty-web": "github:anomalyco/ghostty-web#6e24d040458ddd7aae81572fe2901deec32f9fe7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@happy-dom/global-registrator": "^20.11.15",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "prettier": "^3.6.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
